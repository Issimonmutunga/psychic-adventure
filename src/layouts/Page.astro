---
interface Props {
  title: string;
  description: string;
  path: string;
  eyebrow: string;
}

const { title, description, path, eyebrow } = Astro.props;
// Trailing slash matches the URLs @astrojs/sitemap writes
const url = `https://www.simonmapper.co.ke${path}/`;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title} | Simon Maps</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={url} />
<link rel="icon" href="/favicon.ico" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
<meta property="og:title" content={`${title} | Simon Maps`} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:site_name" content="Simon Maps" />
<meta property="og:image" content="https://www.simonmapper.co.ke/og-image.png" />
<meta property="og:type" content="website" />

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Simon Maps", "item": "https://www.simonmapper.co.ke/" },
    { "@type": "ListItem", "position": 2, "name": title, "item": url }
  ]
})} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --font-display: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Helvetica Neue', 'Inter', Helvetica, Arial, sans-serif;
    --font-body: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', 'Inter', Helvetica, Arial, sans-serif;
    --bg: #ffffff;
    --ink: #0a0a0a;
    --muted: color-mix(in srgb, var(--ink) 56%, var(--bg));
    --soft: #f5f5f7;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0a0a0a;
      --ink: #f2f2f2;
      --soft: #131315;
    }
  }

  body {
    font-family: var(--font-body);
    background: var(--bg);
    color: var(--ink);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  ::selection { background: var(--ink); color: var(--bg); }
  a { color: inherit; }

  .wrap {
    width: min(760px, 100% - 2 * clamp(1rem, 4vw, 2.5rem));
    margin: 0 auto;
  }

  header {
    background: var(--soft);
  }

  header .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .mark {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .mark-pale { color: var(--muted); }
  .mark-deep { font-weight: 800; }

  .back {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
  }

  .back:hover { color: var(--ink); }

  main .wrap {
    padding: clamp(3rem, 8vw, 6rem) 0;
  }

  .eyebrow {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 6vw, 3.8rem);
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 1rem 0 2.5rem;
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 3.2rem 0 0.9rem;
  }

  p, li {
    font-size: 0.98rem;
    color: color-mix(in srgb, var(--ink) 82%, var(--bg));
  }

  p + p { margin-top: 0.9rem; }

  .lede {
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--ink);
  }

  ul {
    margin: 0.8rem 0 0 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 3rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.74rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    text-decoration: none;
    padding: 1.1rem 1.8rem;
    border-radius: 999px;
    background: var(--soft);
    color: var(--ink);
  }

  .btn-solid {
    background: var(--ink);
    color: var(--bg);
  }

  .btn:hover { opacity: 0.85; }

  .channels {
    list-style: none;
    margin: 2rem 0 0;
    gap: 0;
  }

  .channels li {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--soft);
  }

  .channels .channel-name { color: var(--muted); }
  .channels a { text-decoration: none; overflow-wrap: anywhere; }
  .channels a:hover { text-decoration: underline; }

  footer {
    background: var(--soft);
  }

  footer .wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    justify-content: space-between;
    padding: 2rem 0 2.5rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  footer a { text-decoration: none; }
  footer a:hover { color: var(--ink); }
  footer nav { display: flex; flex-wrap: wrap; gap: 0.6rem 1.4rem; }
</style>
</head>

<body>
<header>
  <div class="wrap">
    <a href="/" class="mark" aria-label="Simon Maps home"><span class="mark-pale">simon</span> <span class="mark-deep">maps</span></a>
    <a href="/" class="back">← Back to site</a>
  </div>
</header>

<main>
  <div class="wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <slot />
  </div>
</main>

<footer>
  <div class="wrap">
    <span>© {new Date().getFullYear()} Simon Maps · Nairobi, Kenya</span>
    <nav aria-label="Projects">
      <a href="/latent-earth">Latent Earth</a>
      <a href="/zoryn">Zoryn</a>
      <a href="/property-sales">Property Sales</a>
      <a href="/contact">Contact</a>
    </nav>
    <nav aria-label="Legal">
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms of Service</a>
    </nav>
  </div>
</footer>
</body>
</html>
