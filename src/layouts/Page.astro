---
interface Props {
  title: string;
  description: string;
  path: string;
  eyebrow: string;
  // Live site the page is about, shown as a link under the hero
  site?: { href: string; label: string };
  // Hide the "More projects" row, e.g. on legal pages
  related?: boolean;
}

const { title, description, path, eyebrow, site, related = true } = Astro.props;
// Trailing slash matches the URLs @astrojs/sitemap writes
const url = `https://www.simonmapper.co.ke${path}/`;

const projects = [
  { path: '/latent-earth', name: 'Latent Earth', tag: 'Earth observation lab' },
  { path: '/zoryn', name: 'Zoryn', tag: 'Climate intelligence tool' },
  { path: '/flood-depth', name: 'Flood Depth', tag: 'Flood mapping tool' },
  { path: '/property-sales', name: 'Property Sales', tag: 'Geospatial web application' },
];
const others = projects.filter((p) => p.path !== path);
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title} | Simon Maps</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={url} />
<link rel="icon" href="/favicon.ico" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
<meta property="og:title" content={`${title} | Simon Maps`} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:site_name" content="Simon Maps" />
<meta property="og:image" content="https://www.simonmapper.co.ke/og-image.png" />
<meta property="og:type" content="website" />

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Simon Maps", "item": "https://www.simonmapper.co.ke/" },
    { "@type": "ListItem", "position": 2, "name": title, "item": url }
  ]
})} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --font-display: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Helvetica Neue', 'Inter', Helvetica, Arial, sans-serif;
    --font-body: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', 'Inter', Helvetica, Arial, sans-serif;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --bg: #ffffff;
    --ink: #0a0a0a;
    --muted: color-mix(in srgb, var(--ink) 58%, var(--bg));
    --soft: #f5f5f7;
    --soft-2: #ebebed;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0a0a0a;
      --ink: #f2f2f2;
      --soft: #151517;
      --soft-2: #202023;
    }
  }

  body {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    background: var(--bg);
    color: var(--ink);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  ::selection { background: var(--ink); color: var(--bg); }
  a { color: inherit; text-decoration: none; }
  svg { display: block; }

  :focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 4px;
  }

  .wrap {
    width: min(1080px, 100% - 2 * clamp(1rem, 4vw, 2.5rem));
    margin: 0 auto;
  }

  /* ---- Top bar ---- */

  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
  }

  header .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .mark {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .mark-pale { color: var(--muted); }
  .mark-deep { font-weight: 800; }

  .top-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .top-links a {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted);
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .top-links a:hover { background: var(--soft); color: var(--ink); }

  .top-links a.top-cta {
    background: var(--ink);
    color: var(--bg);
  }

  .top-links a.top-cta:hover {
    background: color-mix(in srgb, var(--ink) 82%, var(--bg));
  }

  /* ---- Hero ---- */

  .hero {
    padding: clamp(3.5rem, 9vw, 6.5rem) 0 clamp(2rem, 5vw, 3rem);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
    background: var(--soft);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
  }

  .chip::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.6;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.25rem, 5.2vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin: 1.25rem 0;
  }

  .lede {
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    line-height: 1.65;
    color: var(--muted);
    max-width: 52ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2.25rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    height: 44px;
    padding: 0 1.4rem;
    border-radius: 999px;
    background: var(--soft);
    color: var(--ink);
    transition: background-color 0.2s var(--ease);
  }

  .btn:hover { background: var(--soft-2); }

  .btn-solid {
    background: var(--ink);
    color: var(--bg);
  }

  .btn-solid:hover { background: color-mix(in srgb, var(--ink) 82%, var(--bg)); }

  .site-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .site-link svg { width: 15px; height: 15px; }
  .site-link:hover { color: var(--ink); }

  /* ---- Content sections ---- */

  .block {
    padding: clamp(2rem, 5vw, 3.5rem) 0;
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-bottom: 0.4rem;
  }

  .block-intro {
    color: var(--muted);
    max-width: 56ch;
  }

  /* Tonal feature cards */
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(215px, 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .feature {
    background: var(--soft);
    border-radius: 24px;
    padding: 1.5rem 1.5rem 1.6rem;
  }

  .icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--bg);
    margin-bottom: 1.1rem;
  }

  .icon svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  h3 {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
    margin-bottom: 0.35rem;
  }

  .feature p {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--muted);
  }

  /* Key facts as label and value tiles */
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .facts div {
    border-radius: 20px;
    padding: 1.1rem 1.3rem;
    background: var(--soft);
  }

  .facts dt {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
    margin-bottom: 0.2rem;
  }

  .facts dd {
    font-size: 0.9375rem;
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .facts a:hover { text-decoration: underline; }

  /* Contact channels as tappable cards */
  .channels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .channel {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--soft);
    border-radius: 24px;
    padding: 1.1rem 1.25rem;
    transition: background-color 0.2s var(--ease);
  }

  .channel:hover { background: var(--soft-2); }
  .channel .icon { margin: 0; }

  .channel-name {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
  }

  .channel-value {
    display: block;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  /* Plain prose, used by legal pages */
  .prose { max-width: 720px; }
  .prose h2 { margin: 2.75rem 0 0.75rem; }
  .prose h2:first-child { margin-top: 0; }
  .prose p, .prose li { color: color-mix(in srgb, var(--ink) 80%, var(--bg)); }
  .prose p + p { margin-top: 0.9rem; }
  .prose ul { margin: 0.75rem 0 0 1.2rem; display: flex; flex-direction: column; gap: 0.45rem; }
  .prose a { text-decoration: underline; text-underline-offset: 3px; }

  /* ---- More projects ---- */

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .related-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-radius: 20px;
    padding: 1.1rem 1.3rem;
    background: var(--soft);
    transition: background-color 0.2s var(--ease);
  }

  .related-card:hover { background: var(--soft-2); }
  .related-card strong { display: block; font-size: 0.9375rem; font-weight: 600; }
  .related-card span { display: block; font-size: 0.8125rem; color: var(--muted); }

  .related-card svg {
    flex: none;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    color: var(--muted);
    transition: transform 0.25s var(--ease);
  }

  .related-card:hover svg { transform: translateX(3px); color: var(--ink); }

  /* ---- Footer ---- */

  footer {
    margin-top: clamp(2rem, 6vw, 4rem);
    background: var(--soft);
  }

  footer .wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: space-between;
    padding: 2rem 0 2.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  footer a:hover { color: var(--ink); }
  footer nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; }

  @media (max-width: 560px) {
    .top-links .top-hide { display: none; }
    .feature { padding: 1.3rem; border-radius: 20px; }
  }
</style>
</head>

<body>
<header>
  <div class="wrap">
    <a href="/" class="mark" aria-label="Simon Maps home"><span class="mark-pale">simon</span> <span class="mark-deep">maps</span></a>
    <nav class="top-links" aria-label="Site">
      <a href="/#services" class="top-hide">Services</a>
      <a href="/#work" class="top-hide">Work</a>
      <a href="/contact" class="top-cta">Get a quote</a>
    </nav>
  </div>
</header>

<main>
  <section class="hero">
    <div class="wrap">
      <span class="chip">{eyebrow}</span>
      <h1>{title}</h1>
      <slot name="hero" />
      {site && (
        <a href={site.href} class="site-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg>
          {site.label}
        </a>
      )}
    </div>
  </section>

  <slot />

  {related && (
    <section class="block">
      <div class="wrap">
        <h2>More projects</h2>
        <div class="related-grid">
          {others.map((p) => (
            <a href={p.path} class="related-card">
              <div><strong>{p.name}</strong><span>{p.tag}</span></div>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6"/></svg>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</main>

<footer>
  <div class="wrap">
    <span>© {new Date().getFullYear()} Simon Maps · Nairobi, Kenya</span>
    <nav aria-label="Projects">
      {projects.map((p) => <a href={p.path}>{p.name}</a>)}
      <a href="/contact">Contact</a>
    </nav>
    <nav aria-label="Legal">
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms of Service</a>
    </nav>
  </div>
</footer>
</body>
</html>
