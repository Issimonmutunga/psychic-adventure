---
import Page from './Page.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  updated: string;
}

const { title, description, path, updated } = Astro.props;
---
<Page title={title} description={description} path={path} eyebrow={`Last updated ${updated}`} related={false}>
  <section class="block">
    <div class="wrap prose">
      <slot />
    </div>
  </section>
</Page>
