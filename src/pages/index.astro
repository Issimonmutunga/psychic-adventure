<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }

  :root {
    --font-display: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, monospace;
    --radius-lg: 26px;
    --radius-md: 18px;
    --radius-sm: 12px;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ---- DARK THEME (default) ---- */
  html[data-theme="dark"] {
    --bg-a: #17100b;
    --bg-b: #2b1b12;
    --bg-c: #5c3a22;
    --bg-d: #c89455;
    --surface: rgba(255, 246, 234, 0.06);
    --surface-strong: rgba(255, 246, 234, 0.11);
    --border: rgba(244, 221, 190, 0.14);
    --border-strong: rgba(244, 221, 190, 0.28);
    --text: #fff7ed;
    --muted: #d6bfa8;
    --dim: #a7876c;
    --accent: #d9a563;
    --accent-2: #9b5c2c;
    --shadow: 0 20px 60px rgba(24, 12, 5, 0.5);
  }

  /* ---- LIGHT THEME ---- */
  html[data-theme="light"] {
    --bg-a: #fbf4ea;
    --bg-b: #ead8c3;
    --bg-c: #c69b72;
    --bg-d: #8a542f;
    --surface: rgba(255, 252, 247, 0.62);
    --surface-strong: rgba(255, 252, 247, 0.86);
    --border: rgba(83, 48, 25, 0.13);
    --border-strong: rgba(83, 48, 25, 0.24);
    --text: #2d1a0e;
    --muted: #70513a;
    --dim: #9a7457;
    --accent: #885126;
    --accent-2: #b6753f;
    --shadow: 0 20px 50px rgba(75, 42, 20, 0.16);
  }

  body {
    font-family: var(--font-display);
    background:
      radial-gradient(ellipse 60% 50% at 12% 8%, color-mix(in srgb, var(--bg-d) 35%, transparent) 0%, transparent 60%),
      radial-gradient(ellipse 70% 60% at 90% 15%, color-mix(in srgb, var(--bg-c) 55%, transparent) 0%, transparent 55%),
      radial-gradient(ellipse 80% 70% at 50% 100%, color-mix(in srgb, var(--bg-c) 30%, transparent) 0%, transparent 60%),
      linear-gradient(180deg, var(--bg-a) 0%, var(--bg-b) 100%);
    background-attachment: fixed;
    color: var(--text);
    min-height: 100vh;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    transition: color 0.3s var(--ease);
  }

  a { color: inherit; text-decoration: none; }
  ul { list-style: none; }

  .wrap { width: min(1080px, 90%); margin: 0 auto; }

  section { padding: clamp(3rem, 8vw, 6.5rem) 0; }

  /* ---- VIEW TRANSITION (theme wipe) ---- */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }
  ::view-transition-old(root) { z-index: 1; }
  ::view-transition-new(root) { z-index: 2; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    * { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
  }

  /* ---- NAV ---- */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 1rem 0;
    backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    background: color-mix(in srgb, var(--bg-a) 55%, transparent);
    border-bottom: 1px solid var(--border);
  }
  .nav .wrap { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .nav-name { font-weight: 800; font-size: 0.95rem; letter-spacing: -0.01em; }
  .nav-links { display: flex; align-items: center; gap: 1.6rem; }
  .nav-links a {
    font-size: 0.82rem; font-weight: 600; color: var(--muted);
    transition: color 0.2s var(--ease);
  }
  .nav-links a:hover { color: var(--text); }

  /* ---- THEME TOGGLE (segmented) ---- */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    position: relative;
  }
  .theme-toggle button {
    position: relative;
    z-index: 2;
    width: 30px; height: 30px;
    display: grid; place-items: center;
    border: none; background: transparent; cursor: pointer;
    border-radius: 999px;
    color: var(--dim);
    transition: color 0.25s var(--ease), transform 0.15s var(--ease);
  }
  .theme-toggle button svg { width: 15px; height: 15px; }
  .theme-toggle button:active { transform: scale(0.85); }
  .theme-toggle button[aria-pressed="true"] { color: var(--bg-a); }
  html[data-theme="light"] .theme-toggle button[aria-pressed="true"] { color: #fff; }
  .theme-toggle .indicator {
    position: absolute;
    top: 4px; left: 4px;
    width: 30px; height: 30px;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    transition: transform 0.35s var(--ease);
    z-index: 1;
  }

  /* ---- HERO ---- */
  .hero {
    min-height: 88vh;
    display: grid;
    align-content: center;
    gap: 1.6rem;
    padding-top: 3rem;
  }
  .geotag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--accent);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
  }
  .geotag::before { content: '●'; font-size: 0.55rem; }

  h1.name {
    font-weight: 900;
    font-size: clamp(3.2rem, 9vw, 7.2rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    background: linear-gradient(120deg, var(--text) 30%, var(--accent-2) 70%, var(--accent) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .role-line {
    font-size: clamp(1rem, 2vw, 1.3rem);
    font-weight: 600;
    color: var(--muted);
  }
  .role-line span { color: var(--accent); }

  .lede {
    max-width: 620px;
    font-size: 1.02rem;
    color: var(--muted);
    font-weight: 400;
  }

  .cta-row { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 0.4rem; }
  .btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    border: 1px solid transparent;
    transition: transform 0.15s var(--ease), box-shadow 0.25s var(--ease);
  }
  .btn:active { transform: scale(0.96); }
  .btn-primary {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: var(--bg-a);
    box-shadow: 0 8px 30px color-mix(in srgb, var(--accent) 35%, transparent);
  }
  html[data-theme="light"] .btn-primary { color: #fff; }
  .btn-primary:hover { box-shadow: 0 12px 36px color-mix(in srgb, var(--accent) 50%, transparent); }
  .btn-ghost {
    background: var(--surface);
    border-color: var(--border);
    color: var(--text);
  }
  .btn-ghost:hover { border-color: var(--border-strong); }

  /* ---- SECTION HEAD ---- */
  .section-head { margin-bottom: 2.2rem; }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 0.6rem;
  }
  h2 {
    font-weight: 800;
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    letter-spacing: -0.02em;
  }

  /* ---- PROFILE ---- */
  .profile-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(1.6rem, 4vw, 2.6rem);
    box-shadow: var(--shadow);
  }
  .profile-card p { color: var(--muted); font-size: 1.05rem; }

  /* ---- GLASS CARD BASE ---- */
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.7rem;
    transition: border-color 0.25s var(--ease), transform 0.25s var(--ease), background 0.25s var(--ease);
  }
  .card:hover { border-color: var(--border-strong); transform: translateY(-3px); background: var(--surface-strong); }

  /* ---- EXPERIENCE ---- */
  .exp-list { display: grid; gap: 1.1rem; }
  .exp-top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.6rem; margin-bottom: 0.9rem; }
  .exp-role { font-weight: 800; font-size: 1.25rem; letter-spacing: -0.01em; }
  .exp-org { color: var(--accent); font-weight: 600; font-size: 0.92rem; }
  .exp-period {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--dim);
    white-space: nowrap;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .exp-list li { color: var(--muted); font-size: 0.93rem; line-height: 1.75; padding-left: 1.1rem; position: relative; margin-bottom: 0.35rem; }
  .exp-list li::before { content: ''; position: absolute; left: 0; top: 0.65em; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }

  /* ---- PROJECTS ---- */
  .project-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.1rem; }
  .project-title { font-weight: 800; font-size: 1.15rem; margin-bottom: 0.6rem; letter-spacing: -0.01em; }
  .project-desc { color: var(--muted); font-size: 0.9rem; margin-bottom: 1.1rem; }
  .project-link {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.78rem; font-weight: 700; color: var(--accent);
  }
  .project-link svg { width: 13px; height: 13px; transition: transform 0.2s var(--ease); }
  .project-link:hover svg { transform: translate(2px, -2px); }

  /* ---- SKILLS ---- */
  .skills-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .skills-grid h3 { font-size: 0.95rem; font-weight: 800; margin-bottom: 0.9rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    padding: 0.35rem 0.8rem;
    font-size: 0.78rem;
    color: var(--muted);
    background: color-mix(in srgb, var(--surface) 60%, transparent);
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  /* ---- CERT / EDU ---- */
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .list-item {
    padding: 1rem 1.2rem;
    background: var(--surface);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 0.7rem;
  }
  .list-item strong { color: var(--text); }

  /* ---- CONTACT ---- */
  .contact-card {
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 18%, var(--surface)), color-mix(in srgb, var(--accent-2) 14%, var(--surface)));
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(2rem, 6vw, 3.5rem);
    text-align: center;
    box-shadow: var(--shadow);
  }
  .contact-card h2 { margin-bottom: 0.8rem; }
  .contact-card p { color: var(--muted); max-width: 480px; margin: 0 auto 1.6rem; }
  .contact-detail-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.7rem; margin-top: 1.6rem; }
  .contact-pill {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: 0.82rem; font-weight: 600;
    padding: 0.6rem 1.1rem;
    background: var(--surface-strong);
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .contact-pill svg { width: 14px; height: 14px; color: var(--accent); }

  footer {
    text-align: center;
    padding: 2rem 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--dim);
  }

  /* ---- RESPONSIVE ---- */
  @media (max-width: 860px) {
    .nav-links a:not(.theme-slot) { display: none; }
    .project-grid, .skills-grid, .two-col { grid-template-columns: 1fr; }
  }
</style>
</head>
