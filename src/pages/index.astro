<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; scroll-padding-top: 76px; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  :root {
    --font-display: 'Manrope', -apple-system, 'Inter', sans-serif;
    --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-playful: 'Baloo 2', 'Manrope', cursive, sans-serif;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --radius: 28px;
    --radius-tile: 16px;
    --gap: 0.9rem;
  }

  /*
    Figure-ground palette
    --bg0      the ground the cards sit on
    --surface  the main card colour
    --accent   the orange theme colour
    --deep     the dark card
  */
  html[data-theme="light"] {
    --bg0: #f0dcc7;
    --surface: #fff7ee;
    --ink0: #2a1608;
    --accent: #f4801f;
    --accent-soft: #f8b987;
    --on-accent: #2a1608;
    --deep: #2a1608;
    --on-deep: #fbeedd;
    --mark: #d9560a;
    --mark-pale: #b08a6c;
  }

  html[data-theme="dark"] {
    --bg0: #0f0904;
    --surface: #1c110a;
    --ink0: #f6e6d3;
    --accent: #ff8f3a;
    --accent-soft: #eeaa78;
    --on-accent: #1b0e05;
    --deep: #2e1b0e;
    --on-deep: #fbeedd;
    --mark: #ff9140;
    --mark-pale: #b9a08a;
  }

  body {
    font-family: var(--font-body);
    background: var(--bg0);
    color: var(--ink0);
    min-height: 100vh;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
    position: relative;
  }

  ::selection {
    background: var(--accent);
    color: var(--on-accent);
  }

  a { color: inherit; text-decoration: none; }
  ul { list-style: none; }
  img { max-width: 100%; display: block; }

  /* Keyboard focus ring is kept for accessibility */
  :focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  ::view-transition-old(root) { z-index: 1; }
  ::view-transition-new(root) { z-index: 2; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }

    * {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }

  /* ---- Layout: every section is one continuous card on the ground ---- */

  section[data-polarity],
  footer[data-polarity] {
    --local-bg: var(--surface);
    --local-ink: var(--ink0);
    --local-tile: color-mix(in srgb, var(--accent) 12%, var(--local-bg));
    --local-tile-hover: color-mix(in srgb, var(--accent) 24%, var(--local-bg));
    width: min(1240px, calc(100% - 1.5rem));
    margin: 0 auto var(--gap);
    border-radius: var(--radius);
    background: var(--local-bg);
    color: var(--local-ink);
    position: relative;
    overflow: hidden;
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
  }

  section[data-polarity="accent"] {
    --local-bg: var(--accent-soft);
    --local-ink: var(--on-accent);
    --local-tile: color-mix(in srgb, var(--on-accent) 9%, var(--accent-soft));
    --local-tile-hover: color-mix(in srgb, var(--on-accent) 15%, var(--accent-soft));
  }

  section[data-polarity="deep"] {
    --local-bg: var(--deep);
    --local-ink: var(--on-deep);
    --local-tile: color-mix(in srgb, var(--on-deep) 10%, var(--deep));
    --local-tile-hover: color-mix(in srgb, var(--on-deep) 16%, var(--deep));
  }

  section[data-polarity="ground"],
  footer[data-polarity="ground"] {
    --local-bg: transparent;
    --local-ink: var(--ink0);
    border-radius: 0;
    overflow: visible;
  }

  section[data-polarity] .wrap,
  footer[data-polarity] .wrap {
    position: relative;
    z-index: 2;
    width: 88%;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) 0;
  }

  .nav .wrap {
    width: calc(min(1240px, 100% - 1.5rem) * 0.88);
    margin: 0 auto;
  }

  footer[data-polarity] .wrap {
    width: calc(min(1240px, 100% - 1.5rem) * 0.88);
    padding: clamp(1.5rem, 3vw, 2rem) 0 clamp(2rem, 4vw, 3rem);
  }

  /* ---- Nav: solid ground colour, no line ---- */

  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 1.1rem 0;
    background: var(--bg0);
  }

  .nav .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  /* Home mark: fades in once the hero mark has scrolled out of view */
  .nav-mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.005em;
    line-height: 1.05;
    text-transform: lowercase;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s var(--ease), visibility 0.25s var(--ease);
  }

  .nav-mark.show {
    opacity: 1;
    visibility: visible;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-left: auto;
  }

  .nav-links a {
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-weight: 500;
    opacity: 0.65;
    transition: opacity 0.2s var(--ease);
  }

  .nav-links a:hover {
    opacity: 1;
  }

  .theme-toggle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink0) 9%, transparent);
    color: var(--ink0);
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .theme-toggle-btn:hover {
    background: var(--accent);
    color: var(--on-accent);
  }

  .theme-toggle-btn svg {
    display: none;
    width: 16px;
    height: 16px;
  }

  .theme-toggle-btn[data-choice="system"] .i-system,
  .theme-toggle-btn[data-choice="light"] .i-light,
  .theme-toggle-btn[data-choice="dark"] .i-dark {
    display: block;
  }

  /* ---- Hero ---- */

  section.hero[data-polarity] .wrap {
    padding: clamp(3rem, 7vw, 5.5rem) 0 clamp(2.5rem, 5vw, 4rem);
  }

  .hero-mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 3vw, 2.3rem);
    letter-spacing: -0.005em;
    line-height: 1.05;
    text-transform: lowercase;
    margin-bottom: 2rem;
  }

  .mark-pale {
    font-weight: 400;
    color: var(--mark-pale);
    line-height: 1.05;
  }

  .mark-deep {
    font-weight: 800;
    line-height: 1.05;
    color: var(--mark);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2.5rem;
    align-items: end;
  }

  h1.headline {
    font-family: var(--font-playful);
    font-style: normal;
    font-weight: 700;
    font-size: clamp(2.2rem, 4.6vw, 3.9rem);
    line-height: 1.15;
    letter-spacing: -0.005em;
    text-transform: none;
  }

  .lede {
    font-size: 1.02rem;
    max-width: 34ch;
    opacity: 0.85;
    align-self: end;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.8rem;
    grid-column: 1 / -1;
  }

  /* Buttons are filled shapes, no borders */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-body);
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 1rem 1.6rem;
    border: none;
    border-radius: 999px;
    background: var(--local-tile);
    color: var(--local-ink);
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .btn-solid {
    background: var(--accent);
    color: var(--on-accent);
  }

  .btn:hover {
    background: var(--local-ink);
    color: var(--local-bg);
  }

  /* ---- Section headings ---- */

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .eyebrow {
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  h2 {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 800;
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    letter-spacing: -0.015em;
  }

  .work-intro {
    margin-top: 0.7rem;
    max-width: 58ch;
    font-size: 0.92rem;
    opacity: 0.65;
  }

  /* ---- Selected work: small tonal tiles inside one card ---- */

  .work-grid {
    --tile-h: 152px;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.6rem;
  }

  .work-card {
    position: relative;
    height: var(--tile-h);
    padding: 0.95rem 1rem;
    border-radius: var(--radius-tile);
    background: var(--local-tile);
    color: var(--local-ink);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: background-color 0.25s var(--ease);
  }

  .work-card:hover,
  .work-card.is-active {
    background: var(--local-tile-hover);
  }

  .work-title {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    display: block;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  /* Category line on the tile so the grid can be scanned at a glance */
  .work-tag-front {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.35;
    margin: 0;
    opacity: 0.6;
  }

  .work-tag {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: -0.005em;
    line-height: 1.25;
    margin: 0;
    opacity: 0.92;
  }

  /* Info button bottom-left, link arrow bottom-right: titles keep the full tile width */
  .work-info-btn {
    position: absolute;
    left: 0.7rem;
    bottom: 0.7rem;
    z-index: 3;
    width: 26px;
    height: 26px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: color-mix(in srgb, var(--local-ink) 10%, transparent);
    color: var(--local-ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .work-info-btn svg {
    width: 16px;
    height: 16px;
  }

  .work-info-btn:hover,
  .work-info-btn[aria-expanded="true"] {
    background: var(--local-ink);
    color: var(--local-bg);
  }

  .card-visit-btn {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 0.8rem 0.9rem;
    border-radius: var(--radius-tile);
    color: var(--local-ink);
  }

  .card-visit-btn svg {
    width: 20px;
    height: 20px;
    stroke-width: 1.6;
    opacity: 0.5;
    transition: transform 0.3s var(--ease), opacity 0.25s var(--ease);
  }

  .work-card:hover .card-visit-btn svg,
  .card-visit-btn:hover svg {
    transform: translateX(3px);
    opacity: 1;
  }

  /* Brand treatments: same families and colours, scaled to the small tile */

  .brand-geoepic {
    font-family: 'EB Garamond', serif;
    font-weight: 500;
    font-size: 1.25rem;
    letter-spacing: 0.005em;
  }

  .brand-geoepic .accent {
    font-style: normal;
    font-weight: 500;
    color: #5b87b3;
  }

  .brand-sauti {
    font-family: 'Playfair Display', serif;
    font-weight: 900;
    font-style: italic;
    letter-spacing: -0.01em;
  }

  .brand-pangakazi {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    text-transform: lowercase;
  }

  .brand-pangakazi .accent {
    font-style: italic;
    font-weight: 500;
    color: #a49660;
  }

  .brand-sarateal {
    font-family: 'Shantell Sans', 'Baloo 2', cursive, sans-serif;
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: -0.005em;
    color: #1e4a3d;
  }

  html[data-theme="dark"] .brand-sarateal {
    color: #6fb59d;
  }

  .brand-tesseract {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-weight: 500;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .brand-tesseract .accent {
    font-weight: 500;
    opacity: 0.5;
  }

  .brand-latent {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 1.05rem;
    letter-spacing: 0.015em;
  }

  .brand-latent .accent {
    color: #1f7f8c;
  }

  html[data-theme="dark"] .brand-latent .accent {
    color: #7fd6e0;
  }

  /* Inline brand colours on a few titles need a lift on the dark ground */
  html[data-theme="dark"] .work-title span[style] {
    filter: brightness(1.35);
  }

  /* Last tile: solid orange, the one deliberate accent in the grid */
  .work-more {
    justify-content: flex-start;
    background: var(--accent-soft);
    color: var(--on-accent);
    transition: filter 0.25s var(--ease);
  }

  .work-more:hover {
    background: var(--accent-soft);
    filter: brightness(1.08);
  }

  .work-more .work-tag-front {
    opacity: 0.75;
  }

  .work-more svg {
    position: absolute;
    right: 0.9rem;
    bottom: 0.8rem;
    width: 20px;
    height: 20px;
    stroke-width: 1.6;
    transition: transform 0.3s var(--ease);
  }

  .work-more:hover svg {
    transform: translateX(3px);
  }

  /* Details panel: opens as a full-width row under the tile that was tapped */
  .work-detail {
    grid-column: 1 / -1;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
    gap: 1.2rem 2.5rem;
    padding: 1.6rem 1.8rem;
    border-radius: var(--radius-tile);
    background: var(--local-tile-hover);
    animation: panel-in 0.35s var(--ease);
  }

  .work-detail[hidden] {
    display: none;
  }

  @keyframes panel-in {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: none; }
  }

  .work-detail-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
  }

  .work-detail-visit {
    margin-top: 0.7rem;
    padding: 0.7rem 1.2rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: filter 0.2s var(--ease);
  }

  .work-detail-visit:hover {
    filter: brightness(1.1);
  }

  .work-detail-close {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    width: 28px;
    height: 28px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: color-mix(in srgb, var(--local-ink) 10%, transparent);
    color: var(--local-ink);
    font-size: 1.05rem;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .work-detail-close:hover {
    background: var(--local-ink);
    color: var(--local-bg);
  }

  .card-back-list {
    list-style: none;
    counter-reset: card-list;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0 2rem 0 0;
  }

  .card-back-list li {
    counter-increment: card-list;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-playful);
    font-weight: 500;
    font-size: 0.92rem;
    line-height: 1.45;
    opacity: 0.9;
  }

  .card-back-list li::before {
    content: counter(card-list) '.';
    font-family: var(--font-playful);
    font-weight: 700;
    opacity: 0.55;
    flex-shrink: 0;
  }

  /* ---- Services: tonal blocks on the orange card ---- */

  .points {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem;
  }

  .point {
    display: block;
    padding: 1.5rem 1.6rem;
    border-radius: var(--radius-tile);
    background: var(--local-tile);
  }

  .point-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .point-title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .point-desc {
    font-family: var(--font-body);
    font-size: 0.9rem;
    opacity: 0.8;
    max-width: 46ch;
  }

  /* The closing cell is the dark figure on the orange ground */
  .point-cta {
    background: var(--on-accent);
    color: var(--accent);
    transition: filter 0.25s var(--ease);
  }

  .point-cta:hover {
    filter: brightness(1.25);
  }

  .point-cta .point-title::after {
    content: ' →';
  }

  /* ---- About: one small pill sitting on the ground ---- */

  #about .wrap {
    padding: 0.2rem 0 0.6rem;
    display: flex;
    justify-content: center;
  }

  .about-strip {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    max-width: 100%;
    padding: 0.5rem 1.4rem 0.5rem 0.5rem;
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink0);
    transition: background-color 0.3s var(--ease);
  }

  .about-strip img {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
  }

  .about-strip p {
    font-size: 0.85rem;
    line-height: 1.45;
    opacity: 0.85;
  }

  .about-name {
    font-family: var(--font-display);
