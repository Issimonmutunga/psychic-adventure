    opacity: 1;
  }

  /* ---- Responsive ---- */

  /* 12 tiles divide evenly into 6, 4, 3 and 2 columns, so no orphan rows */
  @media (max-width: 1000px) {
    .work-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 780px) {
