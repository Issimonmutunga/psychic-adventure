<script>
  /* Theme: system / light / dark */
  (function () {
    const root = document.documentElement;
    const btn = document.getElementById('theme-toggle-btn');
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    const order = ['system', 'light', 'dark'];
    let choice = 'system';

    function resolvedTheme() {
      return choice === 'system'
        ? (media.matches ? 'dark' : 'light')
        : choice;
    }

    function updateLabel() {
      const label = 'Theme: ' + choice;
      btn.dataset.choice = choice;
      btn.setAttribute('aria-label', label);
      btn.setAttribute('title', label);
    }

    function applyTheme(theme) {
      root.setAttribute('data-theme', theme);
    }

    function setChoice(newChoice, event) {
      choice = newChoice;
      updateLabel();

      const theme = resolvedTheme();
      const runSwap = () => applyTheme(theme);

      if (!document.startViewTransition || !event) {
        runSwap();
        return;
      }

      const x = event.clientX;
      const y = event.clientY;

      const endRadius = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y)
      );

      const transition = document.startViewTransition(runSwap);

      transition.ready.then(() => {
        root.animate(
          {
            clipPath: [
              'circle(0px at ' + x + 'px ' + y + 'px)',
              'circle(' + endRadius + 'px at ' + x + 'px ' + y + 'px)'
            ]
          },
          {
            duration: 600,
            easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
            pseudoElement: '::view-transition-new(root)'
          }
        );
      });
    }

    btn.addEventListener('click', e => {
      const next = order[(order.indexOf(choice) + 1) % order.length];
      setChoice(next, e);
    });

    media.addEventListener('change', () => {
      if (choice === 'system') {
        applyTheme(resolvedTheme());
      }
    });

    applyTheme(resolvedTheme());
    updateLabel();
  })();

  /* Nav mark: appears once the hero mark has scrolled out of view */
  (function () {
    const heroMark = document.getElementById('hero-mark');
    const navMark = document.getElementById('nav-mark');
    if (!heroMark || !navMark) return;

    if (!('IntersectionObserver' in window)) {
      navMark.classList.add('show');
      return;
    }

    new IntersectionObserver(function (entries) {
      navMark.classList.toggle('show', !entries[0].isIntersecting);
    }).observe(heroMark);
  })();

  /* Contact form: WhatsApp message and matching email link */
  (function () {
    const form = document.getElementById('contact-form');
    const select = document.getElementById('service-select');
    const emailLink = document.getElementById('email-alt');
    if (!form || !select) return;

    const email = 'besimonmutunga@gmail.com';

    function messageFor(service) {
      return 'Hello Simon, I would like to enquire about ' + service + '. Could we discuss further?';
    }

    function updateEmailLink() {
      if (!emailLink) return;
      const service = select.value;
      emailLink.href = 'mailto:' + email +
        '?subject=' + encodeURIComponent('Enquiry: ' + service) +
        '&body=' + encodeURIComponent(messageFor(service));
    }

    select.addEventListener('change', updateEmailLink);
    updateEmailLink();

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      const url = 'https://wa.me/254706085240?text=' + encodeURIComponent(messageFor(select.value || 'a project'));
      window.open(url, '_blank');
    });
  })();

  /* Work tiles: the info button opens one shared details row under the tapped tile */
  (function () {
    const grid = document.getElementById('work-grid');
    const panel = document.getElementById('work-detail');
    if (!grid || !panel) return;

    let active = null;
    let lastWidth = window.innerWidth;

    function closePanel() {
      if (active) {
        active.classList.remove('is-active');
        const btn = active.querySelector('.work-info-btn');
        if (btn) btn.setAttribute('aria-expanded', 'false');
      }
      active = null;
      panel.hidden = true;
      panel.textContent = '';
    }

    function openPanel(card) {
      closePanel();

      const info = card.querySelector('.work-info');
      const title = card.querySelector('.work-title');
      if (!info || !title) return;

      const head = document.createElement('div');
      head.className = 'work-detail-head';
      head.appendChild(title.cloneNode(true));

      const tag = info.querySelector('.work-tag');
      if (tag) head.appendChild(tag.cloneNode(true));

      const visit = card.querySelector('.card-visit-btn');
      if (visit) {
        const href = visit.getAttribute('href');
        const link = document.createElement('a');
        link.className = 'work-detail-visit';
        link.href = href;
        link.textContent = (visit.getAttribute('aria-label') || 'Open') + ' →';
        if (/^https?:/i.test(href)) {
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
        }
        head.appendChild(link);
      }

      panel.appendChild(head);

      const list = info.querySelector('.card-back-list');
      if (list) panel.appendChild(list.cloneNode(true));

      const close = document.createElement('button');
      close.type = 'button';
      close.className = 'work-detail-close';
      close.setAttribute('aria-label', 'Close details');
      close.textContent = '×';
      close.addEventListener('click', function () {
        const btn = active && active.querySelector('.work-info-btn');
        closePanel();
        if (btn) btn.focus();
      });
      panel.appendChild(close);

      /* Place the panel after the last tile in the same row */
      const tiles = Array.from(grid.querySelectorAll('.work-card'));
      const top = card.offsetTop;
      const row = tiles.filter(function (t) { return Math.abs(t.offsetTop - top) < 3; });
      row[row.length - 1].after(panel);

      active = card;
      card.classList.add('is-active');
      const infoBtn = card.querySelector('.work-info-btn');
      if (infoBtn) infoBtn.setAttribute('aria-expanded', 'true');
      panel.hidden = false;
      panel.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }

    grid.querySelectorAll('.work-card').forEach(function (card) {
      const btn = card.querySelector('.work-info-btn');
      if (!btn) return;
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        if (active === card) {
          closePanel();
        } else {
          openPanel(card);
        }
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && active) {
        const btn = active.querySelector('.work-info-btn');
        closePanel();
        if (btn) btn.focus();
      }
    });

    /* Column count changes with width, so close the row rather than leave it misplaced */
    window.addEventListener('resize', function () {
      if (window.innerWidth !== lastWidth) {
        lastWidth = window.innerWidth;
        closePanel();
      }
    });
  })();
</script>

