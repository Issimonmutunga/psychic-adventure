<body>

<nav class="nav">
  <div class="wrap">
    <div class="nav-links">
      <a href="#services">Services</a>
      <a href="#work">Work</a>
      <a href="#contact">Contact</a>

      <button type="button" class="theme-toggle-btn" id="theme-toggle-btn" aria-label="Change theme">System</button>
    </div>
  </div>
</nav>

<main>

  <section data-polarity="normal">
    <div class="wrap">

      <p class="hero-mark">simon <span class="mark-light">maps</span></p>


      <div class="hero-grid">
        <div>
          <h1 class="headline">Geospatial &amp; Software<br/>Solutions</h1>
        </div>

        <p class="lede">
          I turn geospatial, environmental, and climate data into maps, models, and decision-ready insights — supporting risk assessment, environmental monitoring, land suitability, spatial planning, and data-driven decision making.
        </p>

        <div class="cta-row">
          <a href="#contact" class="btn">Request a Service</a>
          <a href="#services" class="btn">View Services →</a>
        </div>
      </div>
    </div>
  </section>

  <section id="services" data-polarity="invert">
    <div class="wrap">
