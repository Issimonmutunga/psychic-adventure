<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; scroll-padding-top: 72px; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /*
    Monochrome palette
    --bg     page ground
    --ink    text and solid fills
    --soft   quiet tint for hover and panels
    --muted  secondary text
    --line   hairlines
  */
  :root {
    --font-display: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Helvetica Neue', 'Inter', Helvetica, Arial, sans-serif;
    --font-body: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', 'Inter', Helvetica, Arial, sans-serif;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --max: 1240px;
    --gutter: clamp(1rem, 4vw, 2.5rem);

    --bg: #ffffff;
    --ink: #0a0a0a;
    --soft: #f4f4f4;
    --muted: color-mix(in srgb, var(--ink) 56%, var(--bg));
    --line: color-mix(in srgb, var(--ink) 13%, var(--bg));
  }

  html[data-theme="light"] {
    --bg: #ffffff;
    --ink: #0a0a0a;
    --soft: #f4f4f4;
  }

  html[data-theme="dark"] {
    --bg: #0a0a0a;
    --ink: #f2f2f2;
    --soft: #151515;
  }

  body {
    font-family: var(--font-body);
    background: var(--bg);
    color: var(--ink);
    min-height: 100vh;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
  }

  ::selection {
    background: var(--ink);
    color: var(--bg);
  }

  a { color: inherit; text-decoration: none; }
  ul, ol { list-style: none; }
  img { max-width: 100%; display: block; }

  /* Keyboard focus ring is kept for accessibility */
  :focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 4px;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  ::view-transition-old(root) { z-index: 1; }
  ::view-transition-new(root) { z-index: 2; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }

    * {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }

  /* ---- Layout ---- */

  .wrap {
    width: min(var(--max), 100% - 2 * var(--gutter));
    margin: 0 auto;
  }

  .section {
    border-top: 1px solid var(--line);
    padding: clamp(4rem, 9vw, 7.5rem) 0;
  }

  /* ---- Nav ---- */

  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .nav .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 64px;
  }

  /* Wordmark: light muted "simon", bold "maps" */
  .mark-pale {
    color: var(--muted);
  }

  .mark-pale {
    font-weight: 400;
  }

  .mark-deep {
    font-weight: 800;
  }

  /* Home mark: fades in once the hero mark has scrolled out of view */
  .nav-mark {
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: lowercase;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s var(--ease), visibility 0.25s var(--ease);
  }

  .nav-mark.show {
    opacity: 1;
    visibility: visible;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-left: auto;
  }

  .nav-links a {
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--muted);
    transition: color 0.2s var(--ease);
  }

  .nav-links a:hover {
    color: var(--ink);
  }

  .nav-links a.nav-cta {
    color: var(--bg);
    background: var(--ink);
    padding: 0.55rem 1.05rem;
    border: 1px solid var(--ink);
    border-radius: 2px;
    white-space: nowrap;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .nav-links a.nav-cta:hover {
    background: transparent;
    color: var(--ink);
  }

  .theme-toggle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .theme-toggle-btn:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .theme-toggle-btn svg {
    display: none;
    width: 15px;
    height: 15px;
  }

  .theme-toggle-btn[data-choice="system"] .i-system,
  .theme-toggle-btn[data-choice="light"] .i-light,
  .theme-toggle-btn[data-choice="dark"] .i-dark {
    display: block;
  }

  /* ---- Shared type ---- */

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .eyebrow::before {
    content: '';
    width: 28px;
    height: 1px;
    background: currentColor;
  }

  h1, h2, h3 {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  h1 em, h2 em {
    color: var(--muted);
  }

  h2 {
    font-size: clamp(2.5rem, 5.6vw, 4.4rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .section-head {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem 4rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .section-intro {
    font-size: 0.98rem;
    color: var(--muted);
    max-width: 44ch;
    justify-self: end;
  }

  /* Buttons: hairline outline or solid ink, square-edged */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    font-family: var(--font-body);
    font-size: 0.74rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 1.05rem 1.7rem;
    border: 1px solid var(--ink);
    border-radius: 2px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .btn:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .btn-solid {
    background: var(--ink);
    color: var(--bg);
  }

  .btn-solid:hover {
    background: transparent;
    color: var(--ink);
  }

  .btn svg {
    width: 16px;
    height: 16px;
  }

  /* ---- Hero ---- */

  .hero {
    padding: clamp(3.5rem, 9vw, 7rem) 0 clamp(3rem, 6vw, 4.5rem);
  }

  .hero-mark {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: lowercase;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  h1.headline {
    font-size: clamp(3rem, 8.6vw, 7.6rem);
    line-height: 1;
    letter-spacing: -0.045em;
    max-width: 13ch;
  }

  .hero-foot {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem 4rem;
    align-items: end;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .lede {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 50ch;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  /* ---- Services: numbered ledger ---- */

  .service-list {
    border-top: 1px solid var(--ink);
  }

  .service {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1.1fr) minmax(0, 1.3fr) auto;
    gap: 1rem 2.5rem;
    align-items: baseline;
    padding: clamp(1.6rem, 3vw, 2.3rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .service-num {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--muted);
  }

  .service-title {
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .service-desc {
    font-size: 0.95rem;
    color: var(--muted);
    max-width: 48ch;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--line);
    transition: border-color 0.2s var(--ease);
  }

  .service-link svg {
    width: 14px;
    height: 14px;
    transition: transform 0.3s var(--ease);
  }

  .service:hover .service-link {
    border-color: var(--ink);
  }

  .service:hover .service-link svg {
    transform: translateX(3px);
  }

  .services-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    flex-wrap: wrap;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding: clamp(1.6rem, 3vw, 2.2rem) clamp(1.4rem, 3vw, 2.4rem);
    background: var(--soft);
  }

  .services-cta h3 {
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    line-height: 1.1;
  }

  .services-cta p {
    font-size: 0.92rem;
    color: var(--muted);
    margin-top: 0.3rem;
  }

  /* ---- Process ---- */

  .process {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--ink);
  }

  .step {
    padding: 2rem 1.8rem 0.5rem 0;
  }

  .step + .step {
    padding-left: 1.8rem;
    border-left: 1px solid var(--line);
  }

  .step-num {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--muted);
  }

  .step h3 {
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.1;
    margin: 1.4rem 0 0.7rem;
  }

  .step p {
    font-size: 0.92rem;
    color: var(--muted);
  }

  /* ---- Selected work: hairline grid ---- */

  .work-grid {
    --tile-h: 172px;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .work-card {
    position: relative;
    height: var(--tile-h);
    padding: 1.1rem 1.1rem;
    background: var(--bg);
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    transition: background-color 0.25s var(--ease);
  }

  .work-card:hover,
  .work-card.is-active {
    background: var(--soft);
  }

  .work-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.2;
    letter-spacing: -0.015em;
    display: block;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  /* Brand treatments: same families and colours, scaled to the small tile */

  .brand-geoepic {
    font-family: 'EB Garamond', serif;
    font-weight: 500;
    font-size: 1.25rem;
    letter-spacing: 0.005em;
  }

  .brand-geoepic .accent {
    font-style: normal;
    font-weight: 500;
    color: #5b87b3;
  }

  .brand-sauti {
    font-family: 'Playfair Display', serif;
    font-weight: 900;
    font-style: italic;
    letter-spacing: -0.01em;
  }

  .brand-pangakazi {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    text-transform: lowercase;
  }

  .brand-pangakazi .accent {
    font-style: italic;
    font-weight: 500;
    color: #a49660;
  }

  .brand-sarateal {
    font-family: 'Shantell Sans', 'Baloo 2', cursive, sans-serif;
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: -0.005em;
    color: #1e4a3d;
  }

  html[data-theme="dark"] .brand-sarateal {
    color: #6fb59d;
  }

  .brand-tesseract {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-weight: 500;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .brand-tesseract .accent {
    font-weight: 500;
    opacity: 0.5;
  }

  .brand-latent {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 1.05rem;
    letter-spacing: 0.015em;
  }

  .brand-latent .accent {
    color: #1f7f8c;
  }

  html[data-theme="dark"] .brand-latent .accent {
    color: #7fd6e0;
  }

  /* Inline brand colours on a few titles need a lift on the dark ground */
  html[data-theme="dark"] .work-title span[style] {
    filter: brightness(1.35);
  }

  .work-tag-front {
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.4;
    color: var(--muted);
  }

  /* Info button bottom-left, link arrow bottom-right */
  .work-info-btn {
    position: absolute;
    left: 0.8rem;
    bottom: 0.8rem;
    z-index: 3;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .work-info-btn svg {
    width: 14px;
    height: 14px;
  }

  .work-info-btn:hover,
  .work-info-btn[aria-expanded="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .card-visit-btn {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 0.9rem 1rem;
    color: var(--ink);
  }

  .card-visit-btn svg {
    width: 18px;
    height: 18px;
    stroke-width: 1.5;
    opacity: 0.45;
    transition: transform 0.3s var(--ease), opacity 0.25s var(--ease);
  }

  .work-card:hover .card-visit-btn svg,
  .card-visit-btn:hover svg {
    transform: translateX(3px);
    opacity: 1;
  }

  /* Last tile: solid ink, the one inverted block in the grid */
  .work-more {
    background: var(--ink);
    color: var(--bg);
  }

  .work-more:hover {
    background: var(--ink);
  }

  .work-more .work-tag-front {
    color: color-mix(in srgb, var(--bg) 62%, var(--ink));
  }

  .work-more svg {
    position: absolute;
    right: 1rem;
    bottom: 0.9rem;
    width: 18px;
    height: 18px;
    stroke-width: 1.5;
    transition: transform 0.3s var(--ease);
  }

  .work-more:hover svg {
    transform: translateX(3px);
  }

  /* Details row under the tapped tile */
  .work-detail {
    grid-column: 1 / -1;
    position: relative;
    padding: 1.5rem 3.4rem 1.5rem 1.6rem;
    background: var(--soft);
    animation: panel-in 0.35s var(--ease);
  }

  .work-detail[hidden] {
    display: none;
  }

  @keyframes panel-in {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: none; }
  }

  .work-detail-close {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .work-detail-close:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .card-back-list {
    counter-reset: card-list;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .card-back-list li {
    counter-increment: card-list;
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .card-back-list li::before {
    content: counter(card-list, decimal-leading-zero);
    font-family: var(--font-display);
    color: var(--muted);
    flex-shrink: 0;
  }

  /* ---- Contact: the inverted block ---- */

  .contact {
    background: var(--ink);
    color: var(--bg);
    padding: clamp(4rem, 9vw, 7rem) 0;
  }

  .contact .eyebrow,
  .contact .lede2,
  .contact-form label,
  .alt-contact {
    color: color-mix(in srgb, var(--bg) 60%, var(--ink));
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem 5rem;
    align-items: end;
  }

  .contact h2 em {
    color: color-mix(in srgb, var(--bg) 60%, var(--ink));
  }

  .contact .lede2 {
    max-width: 44ch;
    margin-top: 1.4rem;
  }

  /* Direct channels: brand name, then the handle or number */
  .channels {
    margin-top: 2.2rem;
    border-top: 1px solid color-mix(in srgb, var(--bg) 22%, var(--ink));
  }

  .channels li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 0.85rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--bg) 22%, var(--ink));
  }

  .channel-name {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--bg) 60%, var(--ink));
  }

  .channels a {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.3;
    overflow-wrap: anywhere;
    transition: opacity 0.2s var(--ease);
  }

  .channels a:hover {
    opacity: 0.7;
  }

  .text-link {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    max-width: 400px;
    justify-self: end;
  }

  .contact-form label {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* Native select, drawn as an underlined field */
  .select-wrap {
    position: relative;
    width: 100%;
  }

  .select-wrap select {
    -webkit-appearance: none;
    appearance: none;
    display: block;
    width: 100%;
    padding: 0.9rem 2rem 0.9rem 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--bg);
    background: transparent;
    border: none;
    border-bottom: 1px solid color-mix(in srgb, var(--bg) 35%, var(--ink));
    border-radius: 0;
    cursor: pointer;
    transition: border-color 0.2s var(--ease);
  }

  .select-wrap select:hover,
  .select-wrap select:focus {
    border-color: var(--bg);
  }

  .select-wrap select option {
    font-family: var(--font-body);
    font-size: 1rem;
    background: var(--ink);
    color: var(--bg);
  }

  .select-wrap svg {
    position: absolute;
    right: 0.2rem;
    top: 50%;
    width: 14px;
    height: 14px;
    margin-top: -7px;
    pointer-events: none;
  }

  .contact .btn-solid {
    margin-top: 0.6rem;
    background: var(--bg);
    color: var(--ink);
    border-color: var(--bg);
  }

  .contact .btn-solid:hover {
    background: transparent;
    color: var(--bg);
  }

  .alt-contact {
    align-self: flex-start;
    font-size: 0.85rem;
    transition: color 0.2s var(--ease);
  }

  .alt-contact::after {
    content: ' →';
  }

  .alt-contact:hover,
  .alt-contact:focus-visible {
    color: var(--bg);
  }

  /* ---- Footer ---- */

  footer .wrap {
    padding: 2rem 0 2.5rem;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.2rem;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .footer-links a {
    font-size: 0.8rem;
    color: var(--muted);
    transition: color 0.2s var(--ease);
  }

  .footer-links a:hover {
    color: var(--ink);
  }

  .loc-tag {
    font-size: 0.8rem;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .loc-tag-text {
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .footer-mark {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1;
    text-transform: lowercase;
  }

  /* ---- Responsive ---- */

  /* 12 tiles divide evenly into 6, 4, 3 and 2 columns, so no orphan rows */
  @media (max-width: 1000px) {
    .work-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .process {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .step:nth-child(3) {
      padding-left: 0;
      border-left: none;
    }
    .step:nth-child(n + 3) {
      border-top: 1px solid var(--line);
      margin-top: 1.5rem;
    }
  }

  @media (max-width: 860px) {
    .section-head,
    .hero-foot,
    .footer-top {
      grid-template-columns: 1fr;
    }
    .section-intro {
      justify-self: start;
    }
    .service {
      grid-template-columns: 3rem minmax(0, 1fr);
      gap: 0.7rem 1rem;
    }
    .service-desc,
    .service-link {
      grid-column: 2;
    }
    .service-link {
      justify-self: start;
      margin-top: 0.4rem;
    }
    .contact-form {
      max-width: 100%;
      justify-self: stretch;
    }
  }

  @media (max-width: 700px) {
    .work-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .work-card {
      padding: 0.95rem;
    }
    .process {
      grid-template-columns: 1fr;
    }
    .step,
    .step + .step {
      padding: 1.6rem 0 0.4rem;
      border-left: none;
    }
    .step + .step {
      border-top: 1px solid var(--line);
      margin-top: 1.4rem;
    }
    .work-detail {
      padding: 1.3rem 3rem 1.3rem 1.2rem;
    }
    .nav-links {
      gap: 1.2rem;
    }
    .nav-links a[href="#work"] {
      display: none;
    }
  }

  @media (max-width: 400px) {
    .nav-links {
      gap: 0.9rem;
    }
    .nav-links a[href="#services"] {
      display: none;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
    .channels li {
      grid-template-columns: 5.6rem minmax(0, 1fr);
      gap: 0.6rem;
    }
    .channels a {
      font-size: 1rem;
    }
  }
</style>


