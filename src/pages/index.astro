<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{contact.name} | Geospatial Engineer</title>
    <meta
      name="description"
      content="Portfolio of Simon Mutunga Mavindu, a GIS Analyst and Geospatial Engineer working across spatial data analysis, climate risk intelligence, Python automation, and remote sensing."
    />
  </head>

  <body>
    <main>
      <section class="hero">
        <p class="eyebrow">{contact.title}</p>
        <h1>Building practical GIS, climate, and spatial data systems.</h1>
        <p class="intro">
          I am a Geospatial Engineer and GIS Analyst based in Nairobi, Kenya, working across
          spatial data pipelines, climate risk modelling, cartographic mapping, geodatabase
          quality assurance, and API-first geospatial systems.
        </p>

        <div class="actions">
          <a href="#projects">View projects</a>
          <a class="secondary" href={`mailto:${contact.email}`}>Contact me</a>
          <a class="secondary" href={contact.github} target="_blank" rel="noreferrer">GitHub</a>
        </div>
      </section>

      <section class="stats">
        {highlights.map((item) => <article>{item}</article>)}
      </section>

      <section class="profile">
        <div>
          <p class="eyebrow">Based in</p>
          <h2>Nairobi, Kenya</h2>
          <p>
            Available for GIS, climate risk, spatial data engineering, remote sensing, and
            Python automation work.
          </p>
        </div>

        <a class="map-card" href={contact.maps} target="_blank" rel="noreferrer">
          Open location on Google Maps
        </a>
      </section>

      <section id="projects">
        <p class="eyebrow">Selected work</p>
        <h2>Projects</h2>
        <div class="grid">
          {
            projects.map((project) => (
              <article class="card">
                <p class="tag">{project.stack}</p>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                <a class="project-link" href={project.link} target="_blank" rel="noreferrer">
                  View project
                </a>
              </article>
            ))
          }
        </div>
      </section>

      <section>
        <p class="eyebrow">Professional background</p>
        <h2>Experience</h2>
        <div class="timeline">
          {
            experience.map((job) => (
              <article class="card">
                <p class="tag">{job.period} · {job.type}</p>
                <h3>{job.role}</h3>
                <h4>{job.company}</h4>
                <ul>
                  {job.points.map((point) => <li>{point}</li>)}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section>
        <p class="eyebrow">Technical toolkit</p>
        <h2>Skills</h2>
        <div class="grid">
          {
            skillGroups.map((group) => (
              <article class="card">
                <h3>{group.title}</h3>
                <div class="chips">
                  {group.skills.map((skill) => <span>{skill}</span>)}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section>
        <p class="eyebrow">Credentials</p>
        <h2>Certifications</h2>
        <div class="list">
          {certifications.map((item) => <p>{item}</p>)}
        </div>
      </section>

      <section>
        <p class="eyebrow">Education</p>
        <h2>Academic background</h2>
        <div class="list">
          {education.map((item) => <p>{item}</p>)}
        </div>
      </section>

      <section class="contact">
        <p class="eyebrow">Contact</p>
        <h2>Let’s build useful spatial systems.</h2>
        <p>Email: <a href={`mailto:${contact.email}`}>{contact.email}</a></p>
        <p>Phone: <a href={`tel:${contact.phone.replaceAll(" ", "")}`}>{contact.phone}</a></p>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    --bg: #0f172a;
    --panel: #111c33;
    --panel-2: #16223b;
    --border: #243047;
    --text: #e5e7eb;
    --muted: #cbd5e1;
    --accent: #38bdf8;
    --accent-2: #22c55e;
  }

  body {
    margin: 0;
    font-family: Arial, sans-serif;
    background:
      radial-gradient(circle at top left, rgba(56, 189, 248, 0.18), transparent 32rem),
      var(--bg);
    color: var(--text);
  }

  main {
    width: min(1120px, 92%);
    margin: 0 auto;
  }

  section {
    padding: 3.5rem 0;
  }

  .hero {
    min-height: 82vh;
    display: grid;
    align-content: center;
    gap: 1rem;
  }

  .eyebrow,
  .tag {
    color: var(--accent);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
  }

  h1 {
    max-width: 980px;
    margin: 0;
    font-size: clamp(2.7rem, 7vw, 6.4rem);
    line-height: 0.94;
  }

  h2 {
    margin: 0 0 1.4rem;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1;
  }

  h3 {
    margin: 0.4rem 0;
    font-size: 1.35rem;
  }

  h4 {
    margin: 0.2rem 0 1rem;
    color: var(--muted);
  }

  p,
  li {
    color: var(--muted);
    line-height: 1.7;
  }

  .intro {
    max-width: 760px;
    font-size: 1.16rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  a {
    color: var(--accent);
    font-weight: 800;
  }

  .actions a,
  .project-link,
  .map-card {
    padding: 0.9rem 1.2rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--bg);
    text-decoration: none;
  }

  .actions a.secondary,
  .project-link {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
  }

  .stats,
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .stats article,
  .card,
  .list,
  .profile > div {
    background: rgba(17, 28, 51, 0.88);
    border: 1px solid var(--border);
    border-radius: 1.4rem;
    padding: 1.3rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18);
  }

  .profile {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 1rem;
    align-items: stretch;
  }

  .map-card {
    display: grid;
    place-items: center;
    min-height: 220px;
    border-radius: 1.5rem;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    text-align: center;
  }

  .grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .timeline {
    display: grid;
    gap: 1rem;
  }

  ul {
    padding-left: 1.2rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1rem;
  }

  .chips span {
    padding: 0.65rem 0.8rem;
    border-radius: 999px;
    background: var(--panel-2);
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.92rem;
  }

  .contact {
    padding-bottom: 6rem;
  }

  @media (max-width: 900px) {
    .stats,
    .grid,
    .profile {
      grid-template-columns: 1fr;
    }
  }
</style>