<script>
  (function () {
    const root = document.documentElement;
    const btn = document.getElementById('theme-toggle-btn');
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    const order = ['system', 'light', 'dark'];
    let choice = 'system';

    function resolvedTheme() {
      return choice === 'system'
        ? (media.matches ? 'dark' : 'light')
        : choice;
    }

    function updateLabel() {
      btn.textContent = choice.charAt(0).toUpperCase();
    }

    function applyTheme(theme) {
      root.setAttribute('data-theme', theme);
    }

    function setChoice(newChoice, event) {
      choice = newChoice;
      updateLabel();

      const theme = resolvedTheme();
      const runSwap = () => applyTheme(theme);

      if (!document.startViewTransition || !event) {
        runSwap();
        return;
      }

      const x = event.clientX;
      const y = event.clientY;

      const endRadius = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y)
      );

      const transition = document.startViewTransition(runSwap);

      transition.ready.then(() => {
        root.animate(
          {
            clipPath: [
              'circle(0px at ' + x + 'px ' + y + 'px)',
              'circle(' + endRadius + 'px at ' + x + 'px ' + y + 'px)'
            ]
          },
          {
            duration: 600,
            easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
            pseudoElement: '::view-transition-new(root)'
          }
        );
      });
    }

    btn.addEventListener('click', e => {
      const next = order[(order.indexOf(choice) + 1) % order.length];
      setChoice(next, e);
    });

    media.addEventListener('change', () => {
      if (choice === 'system') {
        applyTheme(resolvedTheme());
      }
    });

    applyTheme(resolvedTheme());
    updateLabel();
  })();

  (function () {
    const grid = document.getElementById('work-grid');
    const prev = document.getElementById('work-prev');
    const next = document.getElementById('work-next');
    if (!grid || !prev || !next) return;

    function scrollByCard(dir) {
      const card = grid.querySelector('.work-card');
      const amount = card ? card.getBoundingClientRect().width + 32 : 380;
      grid.scrollBy({ left: dir * amount, behavior: 'smooth' });
    }

    function updateNavState() {
      const maxScroll = grid.scrollWidth - grid.clientWidth;
      prev.disabled = grid.scrollLeft <= 4;
      next.disabled = grid.scrollLeft >= maxScroll - 4;
    }

    prev.addEventListener('click', () => scrollByCard(-1));
    next.addEventListener('click', () => scrollByCard(1));
    grid.addEventListener('scroll', updateNavState);
    window.addEventListener('resize', updateNavState);
    updateNavState();
  })();

  (function () {
    const form = document.getElementById('contact-form');
    const select = document.getElementById('service-select');
    if (!form || !select) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      const service = select.value;
      const message = 'Hello Simon, I would like to enquire about ' + service + '. Could we discuss further?';
      const url = 'https://wa.me/254706085240?text=' + encodeURIComponent(message);
      window.open(url, '_blank');
    });
  })();
</script>

