---
import Page from '../layouts/Page.astro';
---
<Page
  title="Latent Earth"
  description="Latent Earth is a browser laboratory for discovering signals hidden inside Earth-observation embeddings, built by Simon Maps in Nairobi, Kenya."
  path="/latent-earth"
  eyebrow="Ongoing project · Earth observation"
  site={{ href: 'https://le.simonmapper.co.ke/', label: 'le.simonmapper.co.ke' }}
>
  <Fragment slot="hero">
    <p class="lede">A browser laboratory for discovering signals hidden inside Earth-observation embeddings.</p>
    <div class="actions">
      <a href="https://le.simonmapper.co.ke/" class="btn btn-solid">Open Latent Earth</a>
      <a href="/contact" class="btn">Discuss a project</a>
    </div>
  </Fragment>

  <section class="block">
    <div class="wrap">
      <h2>What it does</h2>
      <p class="block-intro">Satellite embeddings, made explorable for people who would rather look than code.</p>
      <div class="features">
        <article class="feature">
          <span class="icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="8" height="16" rx="2"/><rect x="13" y="4" width="8" height="16" rx="2"/></svg></span>
          <h3>Side-by-side views</h3>
          <p>Imagery, embeddings, clusters, and ranked signals compared in one view.</p>
        </article>
        <article class="feature">
          <span class="icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4-4"/></svg></span>
          <h3>No code needed</h3>
          <p>Built for interrogating satellite data straight from the browser.</p>
        </article>
        <article class="feature">
          <span class="icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"/></svg></span>
          <h3>Actively developed</h3>
          <p>Still under active development, with new features added regularly.</p>
        </article>
      </div>
    </div>
  </section>
</Page>
