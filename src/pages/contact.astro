---
import Page from '../layouts/Page.astro';
---
<Page
  title="Contact"
  description="Contact Simon Maps in Nairobi, Kenya for GIS, remote sensing, climate risk, geospatial data engineering, and web development projects. Phone, WhatsApp, or email."
  path="/contact"
  eyebrow="Get in touch"
>
  <Fragment slot="hero">
    <p class="lede">Available for GIS, remote sensing, spatial data, environmental intelligence, AI automation, and geospatial development projects.</p>
    <div class="actions">
      <a href="https://wa.me/254706085240?text=Hello%20Simon%2C%20I%20would%20like%20to%20discuss%20a%20project." target="_blank" rel="noopener noreferrer" class="btn btn-solid">Message on WhatsApp</a>
      <a href="mailto:besimonmutunga@gmail.com" class="btn">Send an email</a>
    </div>
  </Fragment>

  <section class="block">
    <div class="wrap">
      <h2>Ways to reach me</h2>
      <p class="block-intro">Based in Nairobi, Kenya, and working with clients anywhere.</p>
      <div class="channels">
        <a class="channel" href="tel:+254706085240">
          <span class="icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg></span>
          <span><span class="channel-name">Phone</span><span class="channel-value">+254 706 085 240</span></span>
        </a>
        <a class="channel" href="https://wa.me/254706085240" target="_blank" rel="noopener noreferrer">
          <span class="icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.2-4.6A8.5 8.5 0 1 1 21 12z"/></svg></span>
          <span><span class="channel-name">WhatsApp</span><span class="channel-value">+254 706 085 240</span></span>
        </a>
        <a class="channel" href="mailto:besimonmutunga@gmail.com">
          <span class="icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span>
          <span><span class="channel-name">Gmail</span><span class="channel-value">besimonmutunga@gmail.com</span></span>
        </a>
        <a class="channel" href="https://www.linkedin.com/in/invincible-simon" target="_blank" rel="noopener noreferrer">
          <span class="icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 11v6M8 7.5v.01M12 17v-6M12 13.5a2.5 2.5 0 0 1 5 0V17"/></svg></span>
          <span><span class="channel-name">LinkedIn</span><span class="channel-value">invincible-simon</span></span>
        </a>
        <a class="channel" href="https://github.com/Issimonmutunga" target="_blank" rel="noopener noreferrer">
          <span class="icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14"/></svg></span>
          <span><span class="channel-name">GitHub</span><span class="channel-value">Issimonmutunga</span></span>
        </a>
      </div>
    </div>
  </section>
</Page>
